# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/

# Legacy benchmark output directory — should not reappear in this repo.
/benchmarks/

# Type checking
.mypy_cache/
mypy_out.txt

# Linting
.ruff_cache/

# Node (commitlint) — installed locally by scripts/install_hooks.sh so the
# commit-msg hook can enforce the same grammar CI does.
node_modules/
package-lock.json

# gitleaks binary — fetched fresh by scripts/install_gitleaks.sh in every CI
# job that needs it. Never committed; ignored so a local run of that script
# (e.g. to reproduce a release-gate failure) can't end up staged by accident.
/gitleaks

# Package manager cache (uv). The cache dir self-ignores via an internal
# .gitignore, but that is fragile — ignore it explicitly here too so it can
# never be tracked.
.uv-cache/

# uv.lock is deliberately NOT tracked, and this is the reason rather than a
# pointer to one. It was tracked until 2026-09-10 for a reproducible developer
# and CI environment; nothing here builds that environment any more. No
# workflow invokes uv, every CI job installs with pip, and `uv sync` survives
# only inside a Makefile error string. What the file did do was carry pinned
# transitive versions that nobody installs — `pip install engrava` ignores a
# lock entirely — so every security advisory this repository received named
# uv.lock as its manifest and none named pyproject.toml. Alerts about versions
# no user can resolve are not signal, and they crowd out the ones that are.
# Dependency ranges are declared in pyproject.toml; that is the surface a user
# actually resolves and the one worth alerting on. Developers using uv still
# generate this file locally — it is simply not committed. Reinstating it is
# a matter of `uv lock` and deleting the line below.
uv.lock

# OS
.DS_Store
Thumbs.db

# SQLite databases (test artifacts)
*.db
!examples/*.db

# Environment variables
.env
.env.*
.env.local
!.env.example

# pyenv local pin — personal dev preference, not a project fact.
# Supported Python range lives in pyproject.toml (requires-python)
# and the CI matrix in .github/workflows/ci.yml.
.python-version
pytest-out.txt
*.log

# === Sovantica portfolio — defensive .gitignore patterns ===
# Generated by 0.1.0 (2026-05-19T21:27:25Z) from a shared template.
# Appended idempotently by sync-agent-files.sh — do not duplicate by hand.

# Private agent infrastructure — must never enter a public repo working tree.
.agent-shared/
.agent-overrides.yaml
.agent-overrides.yml
.claude/

# Template artefacts — should only ever exist in private workspace.
*.tmpl
*.template.md

# Legacy private agent files (pre-generator era).
.agent/
*.private.md
*-internal.md

# Generator local cache.
.agent-sync.lock
.agent-sync.cache

# Local environment overrides.
.env.*.local

# Publishing keys (e.g. MCP DNS Ed25519) — never commit.
*.pem

# Local publisher binary — never commit.
mcp-publisher
